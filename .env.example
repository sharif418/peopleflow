# PeopleFlow environment
# SQLite control-plane database (tenant registry, HR data — syncs to ERPNext in production)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Session signing secret (generate a strong random value in production)
AUTH_SECRET=change-me-to-a-strong-random-secret

# ── ERPNext integration (Phase 2 — production) ──
# Base URL of the ERPNext instance (e.g. https://erp.peopleflow.com)
# ERPNEXT_BASE_URL=
# API key/secret of the integration user (created via bench)
# ERPNEXT_API_KEY=
# ERPNEXT_API_SECRET=
# Enable live sync to ERPNext sites (when unset → mock mode / control-plane only)
# ERPNEXT_SYNC_ENABLED=true
